# Per-person secrets — TEMPLATE. Copy to `.env` (gitignored) and fill in:
#     cp .env.example .env
# Everything non-sensitive (account ids, workspace ids, roles) lives in config/.

# --- Snowflake: your own user and a Programmatic Access Token (PAT) ---
# Create the PAT once in Snowflake (copy it immediately):
#   ALTER USER <YOU> ADD PROGRAMMATIC ACCESS TOKEN demo_creator ROLE_RESTRICTION = SYSADMIN;
SNOWFLAKE_USER=
SNOWFLAKE_PAT=
# Optional overrides of config/snowflake.toml:
# SNOWFLAKE_ACCOUNT=
# SNOWFLAKE_WAREHOUSE=
# SNOWFLAKE_ROLE=

# --- WisdomAI API keys: one per deployment in config/deployments.toml ---
# Create in Wisdom: Settings -> API Keys. Your user must also be a member of the
# target workspace ("Certified Demos" on proddemo) or every call there returns 403.
proddemo_key=
# staging.gowisdom_key=

# --- Optional: lets the pipeline CREATE the shared Snowflake connection in a workspace that has none.
# The service user Wisdom connects as (read-only role WISDOMAI_READ_ONLY) and its PAT or password.
# Not needed when the connection already exists in the workspace (it is looked up by name).
# WISDOM_CONNECTION_SNOWFLAKE_USER=WISDOMAI_PROD
# WISDOM_CONNECTION_SNOWFLAKE_PAT=
# WISDOM_CONNECTION_SNOWFLAKE_PASSWORD=
